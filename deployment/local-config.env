# Local Development Configuration
# AI Test Automation Platform - Development Environment

# Database Configuration (Local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_automation_platform
DB_USER=app_user
DB_PASSWORD=app_password

# Storage Configuration (Local File System)
STORAGE_TYPE=local
STORAGE_BASE_PATH=/opt/test-automation-platform/data
STORAGE_BUCKET=N/A

# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=5173

# Security Configuration
JWT_SECRET=development_jwt_secret_key_32_chars_min
ENCRYPTION_KEY=development_encryption_key_32_chars

# Monitoring & Logging
LOG_LEVEL=DEBUG
MONITORING_ENABLED=true

# Performance Configuration
MAX_WORKERS=2
TIMEOUT_SECONDS=300
MAX_FILE_SIZE_MB=50

# Feature Flags
ENABLE_AUDIT_LOGGING=true
ENABLE_RLS_POLICIES=true
ENABLE_FILE_ENCRYPTION=false
ENABLE_REAL_TIME_UPDATES=true

# Local Development Settings
CLOUD_PROVIDER=local
REGION=local
AVAILABILITY_ZONE=local

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=7
