# GCP Cloud Deployment Configuration
# AI Test Automation Platform - Production Environment

# Database Configuration (Cloud SQL)
DB_HOST=10.0.0.3
DB_PORT=5432
DB_NAME=test_automation_platform
DB_USER=app_user
DB_PASSWORD=${GCP_DB_PASSWORD}

# Storage Configuration (Google Cloud Storage)
STORAGE_TYPE=gcs
STORAGE_BUCKET=ai-test-automation-files
STORAGE_BASE_PATH=customers
GCS_PROJECT_ID=${GCP_PROJECT_ID}
GCS_CREDENTIALS_PATH=/app/credentials/gcp-service-account.json

# Application Configuration
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=3000

# Security Configuration
JWT_SECRET=${JWT_SECRET_KEY}
ENCRYPTION_KEY=${ENCRYPTION_KEY}

# Monitoring & Logging
LOG_LEVEL=INFO
SENTRY_DSN=${SENTRY_DSN}
MONITORING_ENABLED=true

# Performance Configuration
MAX_WORKERS=4
TIMEOUT_SECONDS=300
MAX_FILE_SIZE_MB=50

# Feature Flags
ENABLE_AUDIT_LOGGING=true
ENABLE_RLS_POLICIES=true
ENABLE_FILE_ENCRYPTION=false
ENABLE_REAL_TIME_UPDATES=true

# Cloud-specific Settings
CLOUD_PROVIDER=gcp
REGION=us-central1
AVAILABILITY_ZONE=us-central1-a

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
